def showFullView(id):
    if cmdargs.silent: return
    last["post"] = id
    success,response = api.getPost(id)
    if success == False:
        raise ConnectionError(response)
    post = response["post"]
    blacklisted = TagMatches.matchAnyTagQualifier(post,effectiveBlacklist)
    if blacklisted:
        printw("§31b§The requested post is blacklisted! Toggle your blacklist off first.")
        return
    if post["file"]["ext"] in ["gif","apng"]: # animated
        printw("§41bd§Animated images don't immediately give input back! (Press CTRL+C to close post)")
    
    if post["file"]["ext"] in ["swf","mp4","webm"]: # non-images
        printw("§41bd§Unable to display image. (swf,mp4,webm are currently unsupported)")
    else:
        path = api.fetchResource(post["file"]["url"],service="https://e621.net")
        try:
            image = term_image.image.from_file(path)
            image.draw(h_align="center",v_align="top",pad_height=1)
        except KeyboardInterrupt as e:
            pass
        print("")
    movedLeft = 0
    movedRight = 0
    leftsize = math.floor(termCols/2)
    rightsize = math.ceil(termCols/2)
    firstRow = [CString("§0b§Attribution:")]
    for tag in post["tags"]["artist"]: firstRow.append(tagArtist(tag))
    for tag in post["tags"]["copyright"]: firstRow.append(tagCopyright(tag))
    for tag in post["tags"]["contributor"]: firstRow.append(tagContributor(tag))
    secondRow = [CString("§0b§Subjects:")]
    for tag in post["tags"]["character"]: secondRow.append(tagCharacter(tag))
    for tag in post["tags"]["species"]: secondRow.append(tagSpecies(tag))
    thirdRow = [CString("§0b§Details:")]
    for tag in post["tags"]["general"]: thirdRow.append(tagGeneral(tag))
    for tag in post["tags"]["lore"]: thirdRow.append(tagLore(tag))
    fourthRow = [CString("§0b§Meta:")]
    for tag in post["tags"]["meta"]: fourthRow.append(tagMeta(tag))
    for tag in post["tags"]["invalid"]: fourthRow.append(tagInvalid(tag))
    movedLeft = printw(CString(" ").join(firstRow),wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(CString(" ").join(secondRow),wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(CString(" ").join(thirdRow),wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(CString(" ").join(fourthRow),wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw("",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§ID:       §§{post["id"]}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§MD5:      §§{post["file"]["md5"]}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§Size:     §§{post["file"]["width"]}x{post["file"]["height"]} ({math.floor(post["file"]["size"]/1024)} KiB)",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§Type:     §§{post["file"]["ext"].upper()}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw("",wrapLen=leftsize,movedLines=movedLeft)

    movedLeft = printw(f"§b§Rating:   {colorRating(post["rating"])}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§Score:    {post["score"]["total"]} (§32§+{post["score"]["up"]} §31§{post["score"]["down"]}§§)",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§Faves:    {post["fav_count"]}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw("",wrapLen=leftsize,movedLines=movedLeft)
    postedTimestamp = datetime.datetime.fromisoformat(post["created_at"])
    since:datetime.timedelta = datetime.datetime.now(datetime.timezone.utc)-postedTimestamp
    postText = "less than a minute ago"
    if since.days >= 365:
        postText = f"{math.floor(since.days/365)} years ago"
    elif since.days >= 365/12:
        postText = f"{math.floor(since.days/365*12)} months ago"
    elif since.days >= 1:
        postText = f"{since.days} days ago"
    elif since.total_seconds() >= 60*60:
        postText = f"{math.floor(since.total_seconds()/60/60)} hours ago"
    elif since.total_seconds() >= 60:
        postText = f"{math.floor(since.total_seconds()/60)} minutes ago"
    movedLeft = printw(f"§b§Posted:   §§{postText}",wrapLen=leftsize,movedLines=movedLeft)
    movedLeft = printw(f"§b§Uploader: §§{post["uploader_name"]}",wrapLen=leftsize,movedLines=movedLeft)
    movup(movedLeft)
    curx(leftsize+1)
    desc = DText.renderDText(post["description"])
    desc = CString(desc).wrap(rightsize)
    desc = CString("\n").join(desc).parse().split("\n")
    for i in desc:
        movedRight = prints(i,movedLines=movedRight)
        curx(leftsize+1)
    movup(movedRight)
    movdown(max(movedLeft,movedRight))
    curx(0)

def showListView(posts,statusString):
    downloads:dict[int,api.concurrent.futures.Future] = {

    }
    permittedPosts = []
    blacklistCt = 0
    for post in posts:
        blacklisted = TagMatches.matchAnyTagQualifier(post,effectiveBlacklist)
        if blacklisted:
            blacklistCt += 1
            continue
        permittedPosts.append(post)
    if cmdargs.silent: return permittedPosts
    printw(statusString)
    printw("§90s§" + " "*termCols)
    blacklistWithNoDisables = [x.lstrip("!") for x in blacklist["tags"]]
    if blacklistCt != 0: printw(f"(§b§{blacklistCt}§§ post{'s' if blacklistCt != 1 else ''} were blacklisted)")
    for i,post in enumerate(permittedPosts):
        downloads[i] = api.fetchResourceAsync(post["preview"]["url"],type="previews",service="https://e621.net")
        pass
    for i,post in enumerate(permittedPosts):
        imgPath = downloads[i].result()
        if imgPath == None:
            print("\n"*10,end="")
            wrapLen = termCols
        else:
            postPreview = term_image.image.from_file(imgPath,height=10)
            if postPreview.width/termCols >= 0.5:
                postPreview.width = math.floor(termCols*0.5)
            postPreview.draw(h_align="right",v_align="top",pad_height=1)
            wrapLen = termCols-postPreview.width
        savecur()
        movup(10)
        movedLines = 0
        firstRow = [CString("§0b§Attribution:")]
        for tag in post["tags"]["artist"]: firstRow.append(tagArtist(tag))
        for tag in post["tags"]["copyright"]: firstRow.append(tagCopyright(tag))
        for tag in post["tags"]["contributor"]: firstRow.append(tagContributor(tag))
        secondRow = [CString("§0b§Subjects:")]
        for tag in post["tags"]["character"]: secondRow.append(tagCharacter(tag))
        for tag in post["tags"]["species"]: secondRow.append(tagSpecies(tag))
        thirdRow = [CString("§0b§Details:")]
        for tag in post["tags"]["general"]: thirdRow.append(tagGeneral(tag))
        for tag in post["tags"]["lore"]: thirdRow.append(tagLore(tag))
        fourthRow = [CString("§0b§Meta:")]
        for tag in post["tags"]["meta"]: fourthRow.append(tagMeta(tag))
        for tag in post["tags"]["invalid"]: fourthRow.append(tagInvalid(tag))
        movedLines = printw(CString(f"§b§Description: §§\n{DText.renderDText(post["description"].rstrip("\n"))}\n"),wrapLen=wrapLen,movedLines=movedLines)
        printw(CString(f"(§b§Idx: §§{i+1})".rjust(wrapLen)))
        movup(1)
        movedLines = printw(CString(f"§b§Id: §§{post["id"]}"),wrapLen=wrapLen,movedLines=movedLines)
        if len(firstRow) > 1: movedLines = printw(CString(" ").join(firstRow),wrapLen=wrapLen,movedLines=movedLines)
        if len(secondRow) > 1: movedLines = printw(CString(" ").join(secondRow),wrapLen=wrapLen,movedLines=movedLines)
        if len(thirdRow) > 1: movedLines = printw(CString(" ").join(thirdRow),wrapLen=wrapLen,movedLines=movedLines)
        if len(fourthRow) > 1: movedLines = printw(CString(" ").join(fourthRow),wrapLen=wrapLen,movedLines=movedLines)
        movedLines = prints("",movedLines=movedLines)
        movedLines = printw(f"§b§Rating: {colorRating(post["rating"])}",wrapLen=wrapLen,movedLines=movedLines)
        if TagMatches.matchAnyTagQualifier(post,blacklistWithNoDisables):
            movedLines = printw(f"",movedLines=movedLines)
            movedLines = printw("§41d§This post would've been blacklisted!§§",movedLines=movedLines)
        # print(CString(" ").join([tagGeneral("general"),tagArtist("artist"),tagContributor("contributor"),tagCopyright("copyright"),tagCharacter("character"),tagSpecies("species"),tagInvalid("invalid"),tagMeta("meta"),tagLore("lore")]))
        # printw(CString.from_flike('{tagGeneral("general")} {tagArtist("artist")} {tagContributor("contributor")} {tagCopyright("copyright")} {tagCharacter("character")} {tagSpecies("species")} {tagInvalid("invalid")} {tagMeta("meta")} {tagLore("lore")}'),wrapLen=wrapLen)
        while movedLines < 10:
            movedLines = prints(f"",movedLines=movedLines)
        movedLines = printw("§90s§" + " "*termCols,movedLines=movedLines)
    printw(statusString)
    if blacklistCt != 0: printw(f"(§b§{blacklistCt}§§ post{'s' if blacklistCt > 1 else ''} were blacklisted)")
    return permittedPosts


