match cmdargs.command:
    case "version":
        printw(f"{consts.app.id} version {consts.app.version} on {platform.system()} ({(platform.platform())})")
        printw(f"Python {platform.python_version()} (impl. {platform.python_implementation()})")
        printw("\n§b§Dependencies:")
        printw(f"- Platformdirs {version("platformdirs")}")
        printw(f"- Requests {version("requests")}")
        printw(f"- Webcolors {version("webcolors")}")
        printw(f"- Term-Image {version("term-image")}")
        printw(f"- Wcwidth {version("wcwidth")}")
    case "download":
        path = args.path
        if path == None:
            success,post = api.getPost(last["post"])
            if not success:
                raise ConnectionError(post)
            post = post["post"]
            artists:list[str] = post["tags"]["artist"]
            artists.remove("conditional_dnp")
            unexpanded = os.path.expanduser(f"~/Pictures/esixterm/__artist__/")
            for i in artists:
                os.makedirs(unexpanded.replace("__artist__",i),exist_ok=True)
            unexpanded += f"{post["file"]["md5"]}.{post["file"]["ext"]}"
            primary = artists[0]
            nonprimary = artists[1:]
            origin = f"/tmp/esixterm/images/{post["file"]["url"].split('/')[-1]}"
            firstpath = unexpanded.replace("__artist__",primary)
            shutil.copyfile(origin,firstpath)
            for i in nonprimary:
                thispath = unexpanded.replace("__artist__",i)
                shutil.copyfile(firstpath,thispath)
            # TODO: copy image and add tags lol
    case "pool":
        if args.pool == "last":
            success,post = api.getPost(last["post"])
            if not success:
                raise ConnectionError(post)
            pools:list[int] = post["post"]["pools"]
            if len(pools) > 1:
                pools.sort()
                targetPool = pools[0]
                printw("§33§Warning: More than one pool; picking the oldest applicable one.")
                printw("All pools are:")
                for i in pools:
                    printw(f"- {i}{' §§32(this one)§§' if i == targetPool else ''}")
            elif len(pools) == 0:
                printw("§41d§Error!§§ Post has no pools.")
                exit(1)
            args.pool = str(targetPool)
        page = math.ceil(args.idx/10)
        idx = ((args.idx-1)%10)+1
        printw("§33§Loading pool...")
        subprocess.run([__file__,"search",f"pool:{args.pool}","order:id","-p",f"{page}","--silent"])
        printw("§33§Loading post...")
        subprocess.run([__file__,"view",f"{idx}"])
        exit(0)
    case "config":
        subprocess.run(["nano",config.getConfPath("conf.json")])
    case "blacklist":
        print(args)
