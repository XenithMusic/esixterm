        last["querypage"] = last["querypage"] + 1
    elif args.direction in ["back","previous"]:
        last["querypage"] = max(last["querypage"] - 1,1)
    elif args.direction in ["first"]:
        last["querypage"] = 1
    elif args.direction.isdigit():
        last["querypage"] = int(args.direction)
    else:
        ap.error(f"argument direction should be one of {allowedPageDirs}, but direction is: {args.direction}")

